From 9d129a4996d465d70c6a220d312a0be7dbe6dc15 Mon Sep 17 00:00:00 2001
From: Ali Nasrullayev <nesrullayev.ali@gmail.com>
Date: Fri, 3 Apr 2026 22:03:31 +0400
Subject: [PATCH 81/97] arch: arm64: dts: qcom: vayu: add display (DRM) support

---
 .../boot/dts/qcom/sm8150-xiaomi-vayu.dts      | 212 ++++-------
 drivers/gpu/drm/panel/Kconfig                 |  20 ++
 drivers/gpu/drm/panel/Makefile                |   2 +
 drivers/gpu/drm/panel/panel-huaxing-nt36672.c | 312 ++++++++++++++++
 drivers/gpu/drm/panel/panel-tianma-nt36672.c  | 333 ++++++++++++++++++
 5 files changed, 740 insertions(+), 139 deletions(-)
 create mode 100644 drivers/gpu/drm/panel/panel-huaxing-nt36672.c
 create mode 100644 drivers/gpu/drm/panel/panel-tianma-nt36672.c

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
index d6c126e1c1..79e5d836b9 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
@@ -42,10 +42,12 @@
 / {
 	model = "Xiaomi POCO X3 Pro";
 	compatible = "xiaomi,vayu", "qcom,sm8150";
+	qcom,msm-id = <QCOM_ID_SM8150 0x20000>; /* SM8150 v2 */
+	qcom,board-id = <47 0>;
+	chassis-type = "handset";
 
 	aliases {
 		serial0 = &uart2;
-		display0 = &framebuffer;
 	};
 
 	battery: battery {
@@ -55,28 +57,6 @@ battery: battery {
 		voltage-max-design-microvolt = <4400000>;
 	};
 
-	chosen {
-		#address-cells = <2>;
-		#size-cells = <2>;
-		ranges;
-	
-		framebuffer: framebuffer@9c000000 {
-			compatible = "simple-framebuffer";
-			reg = <0 0x9c000000 0 (1080 * 2400 * 4)>;
-			width = <1080>;
-			height = <2400>;
-			stride = <(1080 * 4)>;
-			format = "a8r8g8b8";
-			/*
-			 * That's (going to be) a lot of clocks, but it's necessary due
-			 * to unused clk cleanup & no panel driver yet (& no dispcc either)..
-			 */
-			clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
-			    	 <&gcc GCC_DISP_SF_AXI_CLK>;
-		};
-	};
-	
-
 	reserved-memory {
 		tz_mem: memory@86200000 {
 			reg = <0x0 0x86200000 0x0 0x5500000>;
@@ -324,7 +304,7 @@ vreg_l13a_2p7: ldo13 {
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
-		vreg_l14a_1p88: ldo14 {
+		vreg_l14a_1p8: ldo14 {
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1880000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
@@ -466,138 +446,60 @@ vreg_l11c_3p3: ldo11 {
 };
 
 &gmu {
-	status = "disabled";
-};
-
-&mdss {
-	status = "disabled";
-};
-
-&mdss_mdp {
-	status = "disabled";
-};
-
-&dispcc {
-	status = "disabled";
+	status = "okay";
+	firmware-name = "qcom/a640_gmu.bin";
 };
 
 &gpu {
-	/*
-	 * NOTE: "amd,imageon" makes Adreno start in headless mode, remove it
-	 * after display support is added on this board.
-	 */
-	compatible = "qcom,adreno-640.1", "qcom,adreno", "amd,imageon";
+	status = "okay";
+	firmware-name = "qcom/a630_sqe.fw";
 
-	status = "disabled";
-	
 	zap-shader {
 		memory-region = <&gpu_mem>;
 		firmware-name = "qcom/a640_zap.mbn";
 	};
 };
 
-&spi17 {
+&mdss_dsi0 {
+	vdda-supply = <&vdda_mipi_dsi0_1p2>;
 	status = "okay";
-	pinctrl-0 = <&qup_spi17_default>;
 	
-	touch_spi@0 {
-		compatible = "xiaomi,spi-for-tp";
+	display_panel:	panel@0 {
 		reg = <0>;
-		status = "okay";
-		spi-max-frequency = <10000000>;  //10M
-	};
-};
 
-&soc {
-	xiaomi_touch {
-		compatible = "xiaomi-touch";
+		compatible = "tianma,nt36672";
