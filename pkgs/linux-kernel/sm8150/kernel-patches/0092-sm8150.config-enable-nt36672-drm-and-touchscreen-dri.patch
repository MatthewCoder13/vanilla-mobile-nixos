@@ -14,7 +14,10 @@ CONFIG_SND_SOC_CS35L41_I2C=m
 CONFIG_CHARGER_IDTP9418=m
 
 # Xiaomi POCO X3 Pro
+CONFIG_DRM_PANEL_HUAXING_NT36672=m
