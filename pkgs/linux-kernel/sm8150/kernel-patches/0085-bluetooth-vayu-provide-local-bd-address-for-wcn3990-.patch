From 071bb66ba26b39e68414fa1c8c4538024e73e905 Mon Sep 17 00:00:00 2001
From: Ali Nasrullayev <nesrullayev.ali@gmail.com>
Date: Sun, 5 Apr 2026 01:39:42 +0400
Subject: [PATCH 85/97] bluetooth: vayu: provide local-bd-address for wcn3990
 bring-up

WCN3990 firmware loads and UART setup completes, but BlueZ reports zero controllers unless a valid BD_ADDR is provisioned. Add local-bd-address so the controller registers correctly.
---
 arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
index c444ddb49d..352fe5bdb8 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
@@ -47,7 +47,10 @@ / {
 	chassis-type = "handset";
 
 	aliases {
+		bluetooth0 = &bluetooth;
 		serial0 = &uart2;
+		hsuart0 = &uart13;
+		wifi0 = &wifi;
 	};
 
 	battery: battery {
@@ -880,7 +883,8 @@ bluetooth: bluetooth {
 		vddrf-supply = <&vreg_l2c_1p3>;
 		vddch0-supply = <&vreg_l11c_3p3>;
 		max-speed = <3200000>;
-		firmware-name = "vayu/crnv21.bin";
+		firmware-name = "crnv21.bin", "crbtfw21.tlv";
+		local-bd-address = [ cc eb 5e 09 10 2c ];
 	};
 };
 
