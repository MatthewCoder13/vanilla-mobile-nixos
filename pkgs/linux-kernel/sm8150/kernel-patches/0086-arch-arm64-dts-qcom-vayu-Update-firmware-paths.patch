From 442e370abde847c2d912f016ab576ed11d3c2404 Mon Sep 17 00:00:00 2001
From: Ali Nasrullayev <nesrullayev.ali@gmail.com>
Date: Fri, 24 Apr 2026 13:43:43 +0400
Subject: [PATCH 86/97] arch: arm64: dts: qcom: vayu: Update firmware paths

---
 arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts | 14 ++++++--------
 1 file changed, 6 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
index 352fe5bdb8..c13e8aad90 100644
--- a/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-xiaomi-vayu.dts
@@ -11,8 +11,6 @@
 
 #include <dt-bindings/arm/qcom,ids.h>
 #include <dt-bindings/gpio/gpio.h>
-#include <dt-bindings/input/input.h>
-#include <dt-bindings/input/gpio-keys.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
@@ -459,7 +457,7 @@ &gpu {
 
 	zap-shader {
 		memory-region = <&gpu_mem>;
-		firmware-name = "qcom/a640_zap.mbn";
+		firmware-name = "qcom/sm8150/xiaomi/vayu/a640_zap.mbn";
 	};
 };
 
@@ -479,7 +477,7 @@ touchscreen@0 {
 		novatek,swrst-n8-addr = <0x3f0fe>;
 		novatek,spi-rd-fast-addr = <0x3f310>;
 
-		novatek,fw-name = "j20s_novatek_ts_fw01.bin";
+		novatek,fw-name = "novatek/j20s_novatek_ts_fw01.bin";
 	};
 };
 
@@ -661,23 +659,23 @@ &qupv3_id_2 {
 
 &remoteproc_adsp {
 	status = "okay";
-	firmware-name = "qcom/sm8150/vayu/adsp.mbn";
+	firmware-name = "qcom/sm8150/xiaomi/vayu/adsp.mbn";
 };
 
 &remoteproc_cdsp {
 	status = "okay";
-	firmware-name = "qcom/sm8150/vayu/cdsp.mbn";
+	firmware-name = "qcom/sm8150/xiaomi/vayu/cdsp.mbn";
 };
 
 &remoteproc_mpss {
 	status = "okay";
-	firmware-name = "qcom/sm8150/vayu/modem.mbn";
+	firmware-name = "qcom/sm8150/xiaomi/vayu/modem.mbn";
 };
 
 &tlmm {
 	/* gpios 0..3 are NFC spi, gpios 126..129 are FP spi */
 	gpio-reserved-ranges = <0 4>, <126 4>;
-	
+
 	sde_dsi_active: sde_dsi_active {
 		pins = "gpio6", "gpio7";
 		function = "gpio";
-- 
2.56.0

